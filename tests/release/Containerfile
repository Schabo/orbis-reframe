# The GUI half of the release test (scripts/release_test.sh): the target's
# Debian release (BASE) with a headless Sway, PipeWire and the smoke test
# (gpu_smoke.sh, its steps and project) -- but none of the app's own
# libraries. Those come from installing the package under test (the .deb's
# Depends, or the install guide's apt line for the tarball) at run time.
#
#   podman build -t orbis-release-test:debian-13 --build-arg BASE=docker.io/library/debian:trixie tests/release

ARG BASE=docker.io/library/debian:testing
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        sway pipewire pipewire-pulse wireplumber pulseaudio-utils dbus \
        python3 procps xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY run_gui_test.sh /usr/local/bin/
COPY gpu_smoke.sh gpu_smoke.steps smoke.orp /opt/smoke/
