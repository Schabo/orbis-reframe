# The AppImage's GUI test image for Arch (scripts/release_test.sh, as
# tests/release/Containerfile for Debian and Ubuntu): headless Sway,
# PipeWire, the smoke test. Sway carries file capabilities that a rootless
# container refuses to start, so they go.
FROM docker.io/library/archlinux:latest
RUN pacman -Syu --noconfirm sway pipewire pipewire-pulse wireplumber libpulse dbus python procps-ng \
        findutils \
    && setcap -r /usr/bin/sway && pacman -Scc --noconfirm
COPY run_appimage_test.sh /usr/local/bin/
COPY gpu_smoke.sh gpu_smoke.steps smoke.orp /opt/smoke/
