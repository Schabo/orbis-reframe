#version 450
#extension GL_GOOGLE_include_directive : require

// GPU port of insv::FisheyeStitcher::renderEquirect -- NV12 fisheye inputs
// straight from FFmpeg's Vulkan video decoder. Each lens is a 2-plane
// G8_B8R8_2PLANE_420_UNORM image sampled through an immutable
// VkSamplerYcbcrConversion (BT.709, ITU_FULL range), so texture() already
// returns linear-coded RGB in [0,1]. Shares fisheye_stitch_common.glsl.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 1) uniform sampler2D lens0; // ycbcr-conversion sampler (immutable)
layout(binding = 2) uniform sampler2D lens1;

vec3 sampleLens(int i, vec2 uv)
{
    return (i == 0 ? texture(lens0, uv) : texture(lens1, uv)).rgb * 255.0;
}

#include "fisheye_stitch_common.glsl"
